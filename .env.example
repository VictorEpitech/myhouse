# ==========================================
# CONFIGURATION CODEX EPITECH MOULINS
# ==========================================

# Port d'écoute du serveur de production
PORT=3000

# ------------------------------------------
# Authentification Microsoft 365 Entra ID (Azure AD)
# ------------------------------------------
# L'Application (client) ID de votre inscription d'application Microsoft Entra ID
VITE_AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000

# L'autorité Azure AD (common, organizations, ou votre Tenant ID)
# Ex: https://login.microsoftonline.com/common ou https://login.microsoftonline.com/<votre-tenant-id>
VITE_AZURE_AUTHORITY=https://login.microsoftonline.com/common
VITE_AZURE_TENANT_ID=common

# L'URI de redirection autorisée configurée sur le portail Azure Entra ID
# En local : http://localhost:3000 ou http://127.0.0.1:5173
# En production : https://codex.techmoulins.fr
VITE_AZURE_REDIRECT_URI=https://codex.techmoulins.fr

# ------------------------------------------
# Droits Administrateur & Base de Données
# ------------------------------------------
ADMIN_EMAILS=victor1.granger@epitech.eu

# Emplacement du fichier de base de données SQLite persistante (monté dans ./data en Docker)
DATABASE_PATH=/app/data/codex.db
